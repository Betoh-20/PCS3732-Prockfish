# Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais Python
.venv/
venv/
pyvenv.cfg

# Empacotamento Python
*.egg-info/
dist/

# Cache de ferramentas de teste / análise estática
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build do Arduino (poc_xadrez/)
build/
*.o
*.elf

# Nix
result
result-*

# Arquivos temporários
*.tmp
*.log
*.bak
*.swp

# Segredos: CHESS_LICHESS_TOKEN e demais variáveis de ambiente
# consumidas por app/config.py
.env
.env.*
!.env.example

# Credenciais locais (token da Board API do Lichess)
.lichess_token
*.token

# Pandoc / mermaid-filter (make pdf)
docs/*.pdf
mermaid-filter.err
.mermaid-config.json

# O relatório entregue é a exceção: vai versionado junto do fonte .tex,
# porque é o que se anexa à release e se envia no Moodle.
!docs/Relatorio-3.pdf

# Auxiliares do LaTeX (make pdf3 já os apaga; isto cobre compilações à mão)
docs/*.aux
docs/*.toc
docs/*.out
docs/*.synctex.gz
